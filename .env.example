# Copy this file to .env and edit before deploying to production.
DATABASE_URL=sqlite:///./data/railway.db
# For PostgreSQL instead (e.g. a managed Postgres add-on on your host):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=480
CORRIDOR_RADIUS_KM=20
# PORT is usually set automatically by cloud platforms (Render/Railway).
# Leave unset to default to 8000 when running locally.
PORT=8000
